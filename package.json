{
  "name": "ticker-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time stock valuation and ticker tracker with Yahoo Finance, P/E metrics, offline IndexedDB cache, PWA and Cloudflare Workers support.",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/ensure-market-holidays.ts && opennextjs-cloudflare build",
    "build:next": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "npm run build && wrangler deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate:market-holidays": "tsx scripts/generate-market-holidays.ts",
    "cron:trigger": "tsx scripts/trigger-alert-scan.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "^4.3.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.3.5",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "date-holidays": "^3.38.0",
    "postcss": "^8.5.32",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "wrangler": "^4.158.0"
  }
}
